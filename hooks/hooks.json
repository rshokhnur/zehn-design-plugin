{
  "description": "zehn design system: inject rules at session start, style-check UI code after every edit",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-ui.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
